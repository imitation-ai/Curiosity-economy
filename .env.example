# Public browser application token from Better Stack's Frontend tab, not a management API key.
VITE_BETTERSTACK_APPLICATION_TOKEN=

# Optional: one combined PDF URL (including a public Drive file link), or a local path.
# For multiple cover/preface/chapter PDFs, configure book.sources.json instead.
BOOK_SOURCE=
# For private Drive files, supply a short-lived Drive-read OAuth access token to sync.
# Never prefix this with VITE_. Never commit credentials.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Python with scripts/requirements.txt installed; used for book-style DOCX typesetting.
BOOK_PYTHON=python3
