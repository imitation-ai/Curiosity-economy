{
  "name": "book-trailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "demo": "node scripts/create-demo.mjs",
    "sync": "node --env-file-if-exists=.env scripts/sync-book.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run check:publish && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.30.0",
    "pdf-lib": "^1.17.1",
    "vite": "^8.3.0"
  }
}
